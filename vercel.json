{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,.venv/**,.git/**,.pytest_cache/**,.ruff_cache/**,backend/tests/**,backend/app/static/**,.vercel/**,**/__pycache__/**,**/*.pyc,Dockerfile,docker-compose.yml,heroku.yml,Makefile,README.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
